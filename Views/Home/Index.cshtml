                    <div class="mt-3 text-[10px] text-center text-slate-400">You will leave ScoreUp.com • Opens in new tab • We do not collect your data</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        const products = {
            self: { title: 'Self - Credit Builder', icon: 'S', fee: '$0', reports: 'All 3 bureaus', best: 'Building savings', details: 'Credit builder loan + secured card. You make small monthly payments into a locked savings account that reports to all 3 bureaus. At end, you get savings back. No hard pull to check. 6 months avg +60-100 pts for 0 history.', url: 'https://www.self.inc/?utm_source=scoreup' },
            chime: { title: 'Chime Credit Builder', icon: 'C', fee: '$0', reports: 'All 3 bureaus', best: 'Zero fees ever', details: 'Secured Visa with no annual fee, no interest, no credit check to apply. Requires Chime Checking account. Reports to Experian, Equifax, TransUnion. 98% approval for beginners in our test.', url: 'https://www.chime.com/credit-builder/?utm_source=scoreup' },
            kikoff: { title: 'Kikoff', icon: 'K', fee: '$0-$60/yr', reports: 'All 3 bureaus', best: 'Starter tradeline', details: '$0 starter credit line that reports as revolving account. $5/mo premium reports higher limit. No credit check. Good for adding revolving account to thin file.', url: 'https://kikoff.com/?utm_source=scoreup' }
        };

        function openProductModal(key){
            const p = products[key];
            if(!p) return;
            document.getElementById('modalTitle').innerText = p.title;
            document.getElementById('modalIcon').innerText = p.icon;
            document.getElementById('modalFee').innerText = p.fee;
            document.getElementById('modalReports').innerText = p.reports;
            document.getElementById('modalBest').innerText = p.best;
            document.getElementById('modalDetails').innerText = p.details;
            document.getElementById('modalLink').href = p.url;
            document.getElementById('productModal').classList.remove('hidden');
            document.body.classList.add('no-scroll');
            // Track for analytics
            console.log('Product clicked:', key);
            // You can add gtag here: gtag('event', 'product_click', { product: key });
        }
        function closeProductModal(){
            document.getElementById('productModal').classList.add('hidden');
            document.body.classList.remove('no-scroll');
        }

        function updateScore(val){
            val = parseInt(val);
            const base = 520;
            const score = Math.min(850, base + Math.round(val/100*190));
            const score6 = Math.min(850, base + Math.round(val/100*122));
            const score12 = score;
            document.getElementById('scoreDisplay').innerText = score;
            document.getElementById('after6').innerText = score6;
            document.getElementById('after12').innerText = score12;
            document.getElementById('percentText').innerText = val + '% progress';
            document.getElementById('scoreBar').style.width = val + '%';
            const c = document.getElementById('calcScore'); if(c) c.innerText = score12;
            let label = score<580?'POOR':score<670?'FAIR':score<740?'GOOD':'EXCELLENT';
            const lbl = document.getElementById('scoreLabel'); lbl.innerText = label;
            lbl.className = 'mt-1 text-[13px] font-bold tracking-widest ' + (score<580?'text-red-500':score<670?'text-amber-600':score<740?'text-emerald-600':'text-emerald-700');
        }
        function updateRent(val){
            document.getElementById('rentVal').innerText = val;
            const v = parseInt(val);
            let lift = v<800?6:v<1200?10:v<1800?12:v<2500?16:18;
            document.getElementById('rentLift').innerText = '+' + lift + ' points';
        }
        function filterProducts(q){
            q = q.toLowerCase().trim();
            const rows = document.querySelectorAll('.product-row');
            let visible = 0;
            rows.forEach(r=>{ const name = r.getAttribute('data-name'); const show = !q || name.includes(q); r.style.display = show ? '' : 'none'; if(show) visible++; });
            document.getElementById('noResults').classList.toggle('hidden', visible>0);
        }
        function openMenu(){ const m = document.getElementById('mobileMenu'); if(m){ m.classList.remove('hidden'); document.body.classList.add('no-scroll'); } }
        function closeMenu(){ const m = document.getElementById('mobileMenu'); if(m){ m.classList.add('hidden'); document.body.classList.remove('no-scroll'); } }
        document.addEventListener('DOMContentLoaded', function(){
            const closeBtn = document.getElementById('closeMenuBtn'); const overlay = document.getElementById('menuOverlay');
            if(closeBtn) closeBtn.addEventListener('click', closeMenu); if(overlay) overlay.addEventListener('click', closeMenu);
            document.addEventListener('keydown', function(e){ if(e.key==='Escape'){ closeMenu(); closeProductModal(); } });
            updateScore(45); updateRent(1250);
        });
    </script>

</body>
</html>
