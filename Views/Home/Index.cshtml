                <span class="px-3 py-1.5 rounded-full bg-white border border-slate-200">Equifax</span>
                <span class="px-3 py-1.5 rounded-full bg-white border border-slate-200">CFPB</span>
            </div>
            <div class="text-[12px] px-4 py-2 rounded-full bg-white border shadow-sm">
