                <div class="rounded-2xl bg-slate-50 border border-slate-100 p-3 text-center">
                    <div class="text-[12px] text-slate-500">After 6 mo</div>
                    <div class="text-[18px] font-bold mt-1">642</div>
                    <div class="text-[12px] text-emerald-600 font-medium mt-0.5">+122 pts</div>
