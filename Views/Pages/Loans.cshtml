                            </td>
                            <td>Thin file</td>
                            <td>7.4% - 35.99%</td>
                            <td><span class="px-2 py-1 rounded-full bg-slate-50 text-slate-700 text-[11px]">Yes</span></td>
                            <td class="text-right p-4"><a href="#" class="px-4 py-1.5 rounded-full bg-slate-900 text-white text-[12px]">Check Rate</a></td>
                        </tr>
                        <tr class="border-t">
                            <td class="p-4">
                                <div class="font-bold">Oportun</div>
                                <div class="text-[11px] text-slate-500 mt-1">No credit history required</div>
                            </td>
