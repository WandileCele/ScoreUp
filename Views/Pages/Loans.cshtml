        <script>
            const products = {
            self_loan: { title: 'Self - Credit Builder Loan', icon: 'S', fee: '~15.92% APR', reports: 'All 3 bureaus', best: 'Building from 0', details: 'You make small monthly payments into a locked savings account that reports as installment loan to all 3 bureaus. At end, you get savings back minus fees and interest. No hard pull to check eligibility. Best starting point for 0 history. Reports to Experian, Equifax, TransUnion.', url: 'https://www.self.inc/', warning: '' },
            upstart: { title: 'Upstart Personal Loan', icon: 'U', fee: '7.4% - 35.99% APR', reports: 'Yes - 1+ bureau', best: 'Thin file', details: 'Uses AI that considers education and job history, not just credit score. Good for thin files. Check rate with no impact to credit. Origination fee may apply. Minimum credit score not required but income required.', url: 'https://www.upstart.com/', warning: '' },
            oportun: { title: 'Oportun Personal Loan', icon: 'O', fee: '18% - 35.99% APR', reports: 'Yes', best: 'No history at all', details: 'No credit history required. Considers other data. Secured and unsecured options. Reports to credit bureaus to help build. Available in select states. No prepayment penalty.', url: 'https://www.oportun.com/', warning: '' },
            payday_warning: { title: 'AVOID: Payday Loans - CFPB Warning', icon: '!', fee: '~391% APR avg', reports: 'Often No', best: 'Nobody', details: 'CFPB data: Average fee $15 per $100 borrowed = 391% APR. 80% are rolled over or followed by another loan within 14 days. Does NOT build credit in most cases. Traps beginners in debt cycle. We never list or recommend them.', url: 'https://www.consumerfinance.gov/ask-cfpb/what-is-a-payday-loan-en-403/', warning: 'DO NOT USE: Payday loans trap 80% of borrowers. If you need cash now, call 211 or visit local credit union for small-dollar loan. Link goes to CFPB educational page, not a lender.' }
            };
            function openProductModal(key){
            const p = products[key]; if(!p) return;
            document.getElementById('modalTitle').innerText = p.title;
            document.getElementById('modalIcon').innerText = p.icon;
            document.getElementById('modalFee').innerText = p.fee;
            document.getElementById('modalReports').innerText = p.reports;
            document.getElementById('modalBest').innerText = p.best;
            document.getElementById('modalDetails').innerText = p.details;
            document.getElementById('modalLink').href = p.url;
            const warn = document.getElementById('modalWarning');
            if(p.warning){ warn.innerText = p.warning; warn.classList.remove('hidden'); document.getElementById('modalLink').innerText = 'Learn at CFPB.gov →'; document.getElementById('modalLink').className = 'flex-1 h-11 rounded-full bg-slate-900 hover:bg-black text-white font-semibold text-[14px] flex items-center justify-center'; }
            else { warn.classList.add('hidden'); document.getElementById('modalLink').innerText = 'Continue to official site →'; document.getElementById('modalLink').className = 'flex-1 h-11 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-[14px] flex items-center justify-center'; }
            document.getElementById('productModal').classList.remove('hidden');
            document.body.classList.add('no-scroll');
            }
            function closeProductModal(){ document.getElementById('productModal').classList.add('hidden'); document.body.classList.remove('no-scroll'); }
            function openMenu(){ const m=document.getElementById('mobileMenu'); if(m){m.classList.remove('hidden'); document.body.classList.add('no-scroll');} }
            function closeMenu(){ const m=document.getElementById('mobileMenu'); if(m){m.classList.add('hidden'); document.body.classList.remove('no-scroll');} }
            document.addEventListener('DOMContentLoaded', function(){
            const closeBtn=document.getElementById('closeMenuBtn'); const overlay=document.getElementById('menuOverlay');
            if(closeBtn) closeBtn.addEventListener('click', closeMenu); if(overlay) overlay.addEventListener('click', closeMenu);
            document.addEventListener('keydown', function(e){ if(e.key==='Escape'){ closeMenu(); closeProductModal(); } });
            });
        </script>
