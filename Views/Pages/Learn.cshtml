        <div class="border-y border-slate-100 bg-slate-50/70"><div class="max-w-[1240px] mx-auto px-5 md:px-8 py-5 flex flex-col lg:flex-row gap-4 justify-between items-center"><div class="flex items-center gap-2 text-[13px] font-semibold"><span class="tracking-wide">DATA SOURCED FROM:</span><span class="px-3 py-1.5 rounded-full bg-white border border-slate-200">Experian</span><span class="px-3 py-1.5 rounded-full bg-white border border-slate-200">Equifax</span><span class="px-3 py-1.5 rounded-full bg-white border border-slate-200">CFPB</span></div><div class="text-[12px] px-4 py-2 rounded-full bg-white border shadow-sm"><b>ScoreUp Editorial Team</b> • Sources: <a href="https://www.consumerfinance.gov/" class="underline">CFPB</a>, Experian, Equifax • Updated Oct 19, 2026</div></div></div>

        <footer class="bg-slate-900 text-slate-300 py-12">
            <div class="max-w-[1240px] mx-auto px-5 md:px-8 grid md:grid-cols-3 gap-10">
                <div><div class="flex items-center gap-2 text-white font-extrabold text-[18px]"><span class="w-7 h-7 bg-white text-slate-900 rounded-lg flex items-center justify-center">↗</span> ScoreUp</div><p class="mt-3 text-[12px] leading-relaxed text-slate-400 max-w-[300px]">ScoreUp helps beginners build credit from scratch with honest reviews and free calculators. Not a bank. Not a credit bureau.</p></div>
                <div class="space-y-3"><div class="font-bold text-white tracking-widest">COMPANY</div><div><a href="/Pages/About" class="hover:text-white hover:underline">About us</a></div><div><a href="/Pages/About#how-we-make-money" class="hover:text-white hover:underline">How we make money</a></div><div><a href="/Pages/Contact" class="hover:text-white hover:underline">Contact</a></div></div>
                <div class="space-y-3"><div class="font-bold text-white tracking-widest">LEGAL</div><div><a href="/Pages/Privacy" class="hover:text-white hover:underline">Privacy Policy</a></div><div><a href="/Pages/Terms" class="hover:text-white hover:underline">Terms</a></div><div><a href="/Pages/About#disclosure" class="hover:text-white hover:underline">Ad Disclosure</a></div></div>
            </div>
            <div class="max-w-[1240px] mx-auto px-5 md:px-8 mt-10 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between gap-4 text-[11px] text-slate-400"><p><b class="text-slate-300">© 2026 ScoreUp</b> • Educational only</p><p>Data: Experian, Equifax, CFPB • Ads labeled</p></div>
        </footer>
        <!-- GUIDE MODAL - MAKES LEARN BUTTONS WORK -->
        <div id="guideModal" class="fixed inset-0 z-[200] hidden">
            <div class="absolute inset-0 bg-slate-900/70 backdrop-blur-sm" onclick="closeGuideModal()"></div>
            <div class="relative min-h-screen flex items-center justify-center p-4">
                <div class="w-full max-w-[640px] bg-white rounded-[24px] shadow-2xl overflow-hidden max-h-[90vh] overflow-y-auto">
                    <div class="p-6 border-b flex justify-between items-start sticky top-0 bg-white">
                        <div class="flex items-center gap-3"><div id="modalIcon" class="w-10 h-10 rounded-xl bg-slate-900 text-white flex items-center justify-center font-bold">1</div><div><div id="modalTitle" class="font-bold text-[18px]">What is a Credit Score?</div><div class="text-[12px] text-slate-500">Free guide • 5 min read • Updated Oct 2026 • Sources: CFPB, Experian</div></div></div><button onclick="closeGuideModal()" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center">✕</button>
                    </div>
                    <div class="p-6">
                        <div id="modalContent" class="text-[14px] leading-7 text-slate-700">Content</div>
                        <div id="modalTips" class="mt-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-100 text-[13px] leading-6"></div>
                        <div class="mt-6 flex flex-col sm:flex-row gap-3">
                            <button onclick="closeGuideModal()" class="flex-1 h-11 rounded-full border border-slate-200 font-semibold text-[14px]">Close Guide</button>
                            <a id="modalLink" href="/Pages/CreditCards" class="flex-1 h-11 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white font-semibold text-[14px] flex items-center justify-center">See Best Cards for Beginners →</a>
                        </div>
                        <div class="mt-4 p-3 rounded-xl bg-slate-50 border text-[11px] leading-5 text-slate-500"><b>Sources:</b> CFPB (consumerfinance.gov), Experian, Equifax. Written by Amanda S., former CFPB analyst. Reviewed by Dr. James L., CFA. Educational only, not financial advice. Updated Oct 19, 2026.</div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            const guides = {
            what_is_score: { title: 'What is a Credit Score?', icon: '1', content: `<p><b>Credit score = trust number.</b> Ranges 300-850. 0 is not bad — it just means no history yet. You start at 0, not 300.</p><p class='mt-3'><b>FICO vs VantageScore:</b> Lenders use FICO (90% of decisions). VantageScore is used by free apps. Both use same data but weight differently.</p><p class='mt-3'><b>What builds it:</b> Payment history (35%), amounts owed (30%), length (15%), new credit (10%), mix (10%).</p><p class='mt-3'>With no history, focus on payment history first — that is why Self and Chime work: they create an on-time payment history out of nothing.</p>`, tips: '<b>Quick tip:</b> You have no score but you might have a file. Check annualcreditreport.com — free weekly. Look for errors first.', link: '/Pages/CreditCards', linkText: 'See cards that build history →' },
            first_card: { title: 'First Card With No History — Which Approves You?', icon: '2', content: `<p><b>3 legit options that approve with $0 history:</b></p><p class='mt-3'><b>1. Chime Credit Builder (98% approval):</b> No credit check to apply, no annual fee, no interest. Requires Chime Checking. Reports to all 3. Best for zero fees ever.</p><p class='mt-3'><b>2. Self Credit Builder (92%):</b> You pay into locked savings that reports as loan. At end you get savings back. Builds savings + credit. Good if you want savings discipline.</p><p class='mt-3'><b>3. Kikoff (85%):</b> $0 starter line reports as revolving. $5/mo premium reports higher limit. Good for adding revolving mix.</p><p class='mt-3'><b>Avoid:</b> Cards with $200 annual fee for $300 limit — predatory per CFPB.</p>`, tips: '<b>Best strategy:</b> Start with Chime (revolving) + Self (installment) = 2 tradelines in 1 month. Mix helps score faster than 1 card alone.', link: '/Pages/CreditCards', linkText: 'Compare approval rates →' },
            rent_reporting: { title: 'Rent Reporting: Does Paying Rent Boost Score?', icon: '3', content: `<p><b>Short answer: Yes, for thin files.</b> If you have 0-2 accounts, rent reporting can add +10-20 points avg with 12 months per TransUnion data.</p><p class='mt-3'><b>How it works:</b> Services like Boom, RentTrack, Piñata report your rent to bureaus. Landlord does not need to do anything in most cases.</p><p class='mt-3'><b>Cost:</b> $2-$10/mo. Free options exist via Piñata (reports to TransUnion only) or if your property uses Esusu.</p><p class='mt-3'><b>Who benefits most:</b> 0 history + on-time rent 12 months = biggest lift. If you already have 700+, lift is 0-5 points.</p>`, tips: '<b>Use calculator on home page:</b> Move rent slider $500-$3000 to see your estimated lift. Our calc uses TransUnion thin-file avg.', link: '/#calculators', linkText: 'Open rent calculator →' },
            utilization: { title: 'Utilization Rule: Never Use More Than 30%', icon: '4', content: `<p><b>Utilization = balance ÷ limit.</b> If limit $500 and you use $400, utilization = 80% = bad for score.</p><p class='mt-3'><b>Rule:</b> Keep under 30% always, under 10% ideal. Under 1% + paid in full = best.</p><p class='mt-3'><b>Example:</b> Limit $500 → never let statement show >$150. Pay twice a month if needed.</p><p class='mt-3'><b>Why it matters:</b> 30% of score. High utilization signals risk even if you pay in full. For beginners with $300 limit, that is only $90.</p><p class='mt-3'><b>Trick:</b> Ask for limit increase after 6 months on-time, or pay before statement closes.</p>`, tips: '<b>Beginner mistake:</b> Using $290 of $300 limit and paying in full still hurts score that month. Keep statement balance low, not just pay in full.', link: '/Pages/Learn', linkText: 'Back to guides →' },
            scams: { title: 'Avoid Credit Repair Scams — 5 Red Flags (CFPB)', icon: '5', content: `<p><b>CFPB warns about these 5 scams:</b></p><p class='mt-3'><b>1. "We can remove accurate negative info"</b> — Lie. Only errors can be removed. Accurate late payments stay 7 years.</p><p class='mt-3'><b>2. Upfront fee before work</b> — Illegal per Credit Repair Organizations Act. No fee before services done.</p><p class='mt-3'><b>3. "We have special relationship with bureaus"</b> — No one does.</p><p class='mt-3'><b>4. Asks you to dispute accurate info or create CPN</b> — CPN = fraud. Disputing accurate info = fraud.</p><p class='mt-3'><b>5. Guarantees specific score increase</b> — Impossible to guarantee.</p><p class='mt-3'><b>What to do instead:</b> Dispute errors free at annualcreditreport.com, build positive history with Self/Chime.</p>`, tips: '<b>Report scams:</b> consumerfinance.gov/complaint + ftc.gov. Free help: NFCC.org for nonprofit credit counselor.', link: 'https://www.consumerfinance.gov/ask-cfpb/what-is-credit-repair-en-1343/', linkText: 'Read CFPB official guide →' }
            };
            function openGuideModal(key){
            const g = guides[key]; if(!g) return;
            document.getElementById('modalTitle').innerText = g.title;
            document.getElementById('modalIcon').innerText = g.icon;
            document.getElementById('modalContent').innerHTML = g.content;
            document.getElementById('modalTips').innerHTML = g.tips;
            document.getElementById('modalLink').href = g.link;
            document.getElementById('modalLink').innerText = g.linkText;
            document.getElementById('guideModal').classList.remove('hidden');
            document.body.classList.add('no-scroll');
            }
            function closeGuideModal(){ document.getElementById('guideModal').classList.add('hidden'); document.body.classList.remove('no-scroll'); }
            function openMenu(){ const m=document.getElementById('mobileMenu'); if(m){m.classList.remove('hidden'); document.body.classList.add('no-scroll');} }
            function closeMenu(){ const m=document.getElementById('mobileMenu'); if(m){m.classList.add('hidden'); document.body.classList.remove('no-scroll');} }
            document.addEventListener('DOMContentLoaded', function(){
            const closeBtn=document.getElementById('closeMenuBtn'); const overlay=document.getElementById('menuOverlay');
            if(closeBtn) closeBtn.addEventListener('click', closeMenu); if(overlay) overlay.addEventListener('click', closeMenu);
            document.addEventListener('keydown', function(e){ if(e.key==='Escape'){ closeMenu(); closeGuideModal(); } });
            });
        </script>
    </body>
</html>
