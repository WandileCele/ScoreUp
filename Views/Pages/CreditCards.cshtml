    <script>
        const products = {
            chime: { title: 'Chime Credit Builder Visa®', icon: 'C', fee: '$0', reports: 'All 3 bureaus', best: '98% approval', details: 'Secured Visa with no annual fee, no interest, no credit check to apply. Requires Chime Checking. Reports to Experian, Equifax, TransUnion. Best for beginners who want zero fees ever. 98% approval rate in our beginner test.', url: 'https://www.chime.com/credit-builder/' },
            self: { title: 'Self - Credit Builder Loan', icon: 'S', fee: '$0', reports: 'All 3 bureaus', best: '92% approval', details: 'Credit builder loan + optional secured card. You make monthly payments into locked savings that reports to all 3 bureaus. At end, you get savings back minus fees. No hard pull to check. Builds savings + credit.', url: 'https://www.self.inc/' },
            kikoff: { title: 'Kikoff Credit Builder', icon: 'K', fee: '$0-$60/yr', reports: 'All 3 bureaus', best: '85% approval', details: '$0 starter credit line that reports as revolving account. $5/mo premium reports higher limit. No credit check. Good for adding revolving account to thin file. Reports to all 3 bureaus.', url: 'https://kikoff.com/' },
            discover: { title: 'Discover it® Secured Card', icon: 'D', fee: '$0', reports: 'All 3 bureaus', best: '78% approval', details: 'Secured card with 2% cashback at gas stations and restaurants (up to quarterly max) and 1% else. No annual fee. Automatic reviews for upgrade to unsecured. Requires $200 deposit min. Reports to all 3 bureaus.', url: 'https://www.discover.com/credit-cards/secured/' }
        };
        function openProductModal(key){
            const p = products[key]; if(!p) return;
            document.getElementById('modalTitle').innerText = p.title;
            document.getElementById('modalIcon').innerText = p.icon;
            document.getElementById('modalFee').innerText = p.fee;
            document.getElementById('modalReports').innerText = p.reports;
            document.getElementById('modalBest').innerText = p.best;
            document.getElementById('modalDetails').innerText = p.details;
            document.getElementById('modalLink').href = p.url;
            document.getElementById('productModal').classList.remove('hidden');
            document.body.classList.add('no-scroll');
        }
        function closeProductModal(){ document.getElementById('productModal').classList.add('hidden'); document.body.classList.remove('no-scroll'); }
        function openMenu(){ const m=document.getElementById('mobileMenu'); if(m){m.classList.remove('hidden'); document.body.classList.add('no-scroll');} }
        function closeMenu(){ const m=document.getElementById('mobileMenu'); if(m){m.classList.add('hidden'); document.body.classList.remove('no-scroll');} }
        document.addEventListener('DOMContentLoaded', function(){
            const closeBtn=document.getElementById('closeMenuBtn'); const overlay=document.getElementById('menuOverlay');
            if(closeBtn) closeBtn.addEventListener('click', closeMenu); if(overlay) overlay.addEventListener('click', closeMenu);
            document.addEventListener('keydown', function(e){ if(e.key==='Escape'){ closeMenu(); closeProductModal(); } });
        });
    </script>
