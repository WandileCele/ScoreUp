                            <div class="text-[11px] text-slate-500">Former CFPB Analyst | 8+ years consumer credit</div>
                        </div>
                    </div>
                    <div class="hidden md:block w-px bg-slate-200 self-stretch"></div>
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-emerald-50 border text-emerald-700 flex items-center justify-center font-bold text-[11px]">CFA</div>
                        <div>
                            <div class="text-[13px] font-bold leading-tight">Reviewed by Dr. James L., CFA</div>
                            <div class="text-[11px] text-slate-500">ScoreUp Review Board • E-E-A-T Verified</div>
                        </div>
                    </div>
